# === Build Directories (The most important part) ===
# This ignores all build folders regardless of name (e.g., cmake-build-debug, build, out)
cmake-build-*/
build/
bin/
obj/
out/

# === CMake Artifacts ===
# These are generated by CMake and shouldn't be shared (they contain local paths)
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake

# === CLion / JetBrains Settings ===
# Ignores your personal UI layout and local history
.idea/
cmake-build-debug/
cmake-build-release/

# === Compiled Binaries & Libraries ===
# This ignores the actual executable and static libraries you build
*.exe
*.out
*.app
*.a
*.ofind GRAVIX/ -name ".git" -type d
*.so

#Project Specific
GravixApp
libEngine.a

# === System Specific (Linux/Fedora) ===
.DS_Store
.directory
*~
*.swp